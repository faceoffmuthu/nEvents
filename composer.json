{
    "name": "nevents/platform",
    "description": "N Events — Personalized Event Discovery Platform for Tamil Nadu",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6",
        "ramsey/uuid": "^4.7",
        "phpmailer/phpmailer": "^6.9",
        "league/commonmark": "^2.5",
        "psr/log": "^3.0",
        "monolog/monolog": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "NEvents\\": "app/",
            "NEvents\\Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NEvents\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php",
        "create-admin": "php bin/create-admin.php",
        "worker": "php bin/worker.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
