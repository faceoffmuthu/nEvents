# Application
APP_NAME="N Events"
APP_ENV=development
APP_URL=http://localhost/Lordminds/N_Events/public
APP_SECRET=your-32-char-secret-key-here-change-me
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nevents
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session
SESSION_NAME=nevents_session
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Mail
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@nevents.in
MAIL_FROM_NAME="N Events"

# WhatsApp: the WhatsApp/mobile number is collected at signup only.
# No WhatsApp API, provider or credentials are used.

# Google OAuth / Calendar (not implemented — the "Add to Google Calendar"
# link and .ics download need no credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AI Provider (optional — system works without it)
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=

# Search
SEARCH_DRIVER=mysql
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# Cache
CACHE_DRIVER=filesystem
CACHE_TTL=3600

# File Storage
STORAGE_DRIVER=local
UPLOAD_MAX_SIZE_MB=10

# User event posting
USER_EVENT_MAX_PER_HOUR=5
USER_EVENT_MAX_PER_DAY=20
EVENT_IMAGE_MAX_MB=5
REPORT_MAX_PER_DAY=10

# Discovery pipeline
DISCOVERY_AUTO_PUBLISH_MIN_CONFIDENCE=80
DISCOVERY_AUTO_PUBLISH_MIN_TRUST=70
# Keyless crawler / feeds: User-Agent (matched against robots.txt), per-host delay, pages per source per run
# DISCOVERY_USER_AGENT="NEventsBot/1.0 (event discovery; +https://your-domain/about)"
DISCOVERY_MIN_DELAY_MS=1500
DISCOVERY_MAX_PAGES=40
# Test suite only (local fixture site); ignored when APP_ENV=production. Leave empty.
DISCOVERY_TEST_HOSTS=
SOCIAL_RAW_RETENTION_DAYS=30

# Approved social / search API access (leave empty = connector disabled)
META_GRAPH_API_VERSION=v21.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_IDS=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_IDS=
X_BEARER_TOKEN=
SEARCH_PROVIDER=none

# Feature Flags
FEATURE_GOOGLE_CALENDAR_OAUTH=false
FEATURE_AI_EXTRACTION=false
FEATURE_ORGANIZER_PORTAL=true
FEATURE_RECOMMENDATION_SCORE_PUBLIC=false
FEATURE_TAMIL_UI=false

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=900

# Email Verification Policy
REQUIRE_EMAIL_VERIFICATION=true
VERIFY_TOKEN_TTL_HOURS=24
RESEND_VERIFICATION_COOLDOWN_SECONDS=60

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=daily
